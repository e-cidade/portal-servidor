APP_NAME="Portal Servidor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://contassconsultoria.com.br
APP_PORT=80
VITE_PORT=5183
WWWUSER=1000
WWWGROUP=1000
FORWARD_REDIS_PORT=6389

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
APP_DOMAIN=contassconsultoria.com.br

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=clientes
DB_USERNAME=ecidade
DB_PASSWORD=
DB_POOL_ENABLED=false

DB_CONNECTION=central
DB_CENTRAL_HOST=host.docker.internal
DB_CENTRAL_PORT=5432
DB_CENTRAL_DATABASE=clientes
DB_CENTRAL_USERNAME=ecidade
DB_CENTRAL_PASSWORD=
DB_CENTRAL_POOL_ENABLED=false

TENANCY_DB_DATABASE=clientes
CENTRAL_DOMAINS=contassconsultoria.com.br
# Default para databases de TENANT (pode sobrescrever por tenant)
TENANT_DB_HOST=host.docker.internal
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=ecidade
TENANT_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.contassconsultoria.com.br

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


CODIGOINSTITUICAO=1

PM_INSTITUICAO=1
CM_INSTITUICAO=2
SA_INSTITUICAO=7
PR_INSTITUICAO=6
